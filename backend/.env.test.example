# Settings for the API tests (npm run test:e2e).
# Copy this file to backend/.env.test. Create the database first: cd db && npm run db:test:setup
# The database name must end with _test, or the tests refuse to run.
NODE_ENV=test

DATABASE_URL=postgresql://devtrack_app:devtrack_app@localhost:5432/devtrack_test?schema=public

# Test-only values, not real secrets.
JWT_ACCESS_SECRET=local-test-only-secret-not-used-anywhere-else
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
