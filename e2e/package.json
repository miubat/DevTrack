{
  "name": "e2e",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:local": "TARGET=local playwright test",
    "test:staging": "TARGET=staging playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "HEADLESS=false playwright test",
    "report": "playwright show-report",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts\"",
    "format:check": "prettier --check \"**/*.ts\""
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "prettier": "^3.9.10",
    "typescript": "~7.0.2"
  }
}
